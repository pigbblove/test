      function renderExamResults() {
        const gradeFilter = document.getElementById("filterResultGrade").value;
        const classFilter = document.getElementById("filterResultClass").value.trim();

        const filtered = examResults.filter(function (r) {
          const gOk = gradeFilter === "ALL" || String(r.grade) === gradeFilter;
          const cOk = !classFilter || String(r.classNum) === String(Number(classFilter));
          return gOk && cOk;
        });

        document.getElementById("statTotalAttempts").textContent = filtered.length + "건";

        if (filtered.length === 0) {
          document.getElementById("statAvgAccuracy").textContent = "0%";
          document.getElementById("statPerfectCount").textContent = "0회";
        } else {
          const sumAcc = filtered.reduce(function (acc, r) { return acc + (Number(r.accuracy) || 0); }, 0);
          const avgAcc = Math.round(sumAcc / filtered.length);
          const perfectCnt = filtered.filter(function (r) { return Number(r.accuracy) === 100; }).length;
          document.getElementById("statAvgAccuracy").textContent = avgAcc + "%";
          document.getElementById("statPerfectCount").textContent = perfectCnt + "회";
        }

        const listEl = document.getElementById("examResultsList");
        listEl.innerHTML = "";

        if (filtered.length === 0) {
          const empty = document.createElement("p");
          empty.textContent = "조건에 맞는 학생 시험 결과가 아직 없습니다. 학생이 받아쓰기를 완료하면 여기에 기록됩니다.";
          listEl.appendChild(empty);
          return;
        }

        filtered.forEach(function (r) {
          const card = document.createElement("div");
          card.className = "result-card";

          const header = document.createElement("div");
          header.className = "result-header";

          const studentLabel = document.createElement("span");
          studentLabel.textContent = r.grade + "학년 " + r.classNum + "반 " + r.studentNum + "번 · " + r.unit;

          const scoreTag = document.createElement("span");
          scoreTag.className = "score-tag";
          scoreTag.textContent =
            "첫 시도 정답 " + r.firstTryCorrectCount + "/" + r.totalCount + " (" + r.accuracy + "%)";

          header.appendChild(studentLabel);
          header.appendChild(scoreTag);

          const wrongLine = document.createElement("div");
          wrongLine.style.fontWeight = "700";
          wrongLine.style.color = r.wrongWords && r.wrongWords.length > 0 ? "#c92a2a" : "#2b8a3e";
          wrongLine.textContent =
            r.wrongWords && r.wrongWords.length > 0
              ? "틀린 단어/문장: " + r.wrongWords.join(", ") + (r.retryCleared ? " (재시험 통과)" : " (재시험 확인 필요)")
              : "틀린 문제 없음 (완벽 통과!)";

          const timeLine = document.createElement("div");
          timeLine.style.fontSize = "15px";
          timeLine.style.color = "#5c5f77";
          timeLine.style.marginTop = "4px";
          timeLine.textContent = "응시 시각: " + r.playedAt;

          card.appendChild(header);
          card.appendChild(wrongLine);
          card.appendChild(timeLine);
          listEl.appendChild(card);
        });
      }

