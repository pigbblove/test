        const record = {
          id: "res-" + Date.now() + "-" + Math.floor(Math.random() * 1000),
          grade: studentInfo.grade || "5",
          classNum: studentInfo.classNum || "?",
          studentNum: studentInfo.studentNum || "?",
          unit: currentSessionUnitLabel,
          totalCount: studyQueue.length,
          firstTryCorrectCount: firstTryCorrectCount,
          accuracy: accuracy,
          wrongWords: wrongItemsInSession.map(function (w) { return w.english; }),
          retryCleared: retryCleared,
          playedAt: new Date().toLocaleString("ko-KR")
        };
        examResults.unshift(record);
        saveExamResults();
      }

