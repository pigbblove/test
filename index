         10. 5번 따라 쓰기 입력칸 생성기
      ========================================================= */
      function buildFiveRepeatInputs(containerEl, targetText, onAllComplete) {
        containerEl.innerHTML = "";
        const completedFlags = [false, false, false, false, false];

        for (let i = 0; i < 5; i++) {
          const row = document.createElement("div");
          row.className = "repeat-row";

          const numLabel = document.createElement("span");
          numLabel.className = "repeat-num";
          numLabel.textContent = (i + 1) + "번째";

          const input = document.createElement("input");
          input.type = "text";
          input.className = "repeat-input";
          input.autocomplete = "off";
          input.spellcheck = false;
          input.placeholder = targetText;

          const status = document.createElement("span");
          status.className = "repeat-status";
          status.textContent = "✏️ 대기중";
          status.style.color = "#868e96";

          input.addEventListener("input", function () {
            const ok = normalizeEnglish(input.value) === normalizeEnglish(targetText);
            completedFlags[i] = ok;
            if (ok) {
              status.textContent = "⭕ 완료!";
              status.style.color = "#2b8a3e";
              input.style.borderColor = "#40c057";
              input.style.backgroundColor = "#ebfbee";
            } else {
              status.textContent = "✍️ 쓰는 중";
              status.style.color = "#e67700";
              input.style.borderColor = "#ffd8a8";
              input.style.backgroundColor = "#ffffff";
            }
            onAllComplete(completedFlags.every(Boolean));
          });

          row.appendChild(numLabel);
          row.appendChild(input);
          row.appendChild(status);
          containerEl.appendChild(row);
        }
      }

