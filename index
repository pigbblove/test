      function normalizeEnglish(str) {
        return String(str || "")
          .trim()
          .replace(/\s+/g, " ")
          .replace(/[.?!,]+$/g, "")
          .toLowerCase();
      }

      function normalizeKorean(str) {
        return String(str || "")
          .trim()
          .replace(/\s+/g, "")
          .replace(/[.?!,~]+$/g, "")
          .replace(/(입니다|이에요|예요|해요|한다|하다|이야|야|니|어|아|요)$/g, "");
      }

      function checkEnglishMatch(userInput, target) {
        return normalizeEnglish(userInput) === normalizeEnglish(target);
      }

      function checkMeaningMatch(userInput, acceptedMeanings) {
        const normUser = normalizeKorean(userInput);
        if (!normUser) return false;
        return acceptedMeanings.some(function (m) {
          const normTarget = normalizeKorean(m);
          if (!normTarget) return false;
          return (
            normUser === normTarget ||
            (normUser.length >= 2 && normTarget.includes(normUser)) ||
            (normTarget.length >= 2 && normUser.includes(normTarget))
          );
        });
      }

