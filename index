          curriculum.push({
            id: "custom-" + Date.now(),
            grade: grade,
            unit: unit,
            type: type,
            english: english,
            meanings: meanings,
            hint: hint,
            meaningTheme: resolveMeaningTheme({ english: english, meanings: meanings }),
            enrichEn: enrichEn || "Well done!",
            enrichKo: enrichKo || "참 잘했어! (원어민 격려 표현)"
          });
          msg.className = "msg-box msg-success";
          msg.textContent = "새 문제를 추가했습니다!";
        }

        msg.classList.remove("hidden");
        saveCurriculum();
        clearTeacherForm();
        renderTeacherList();
        refreshHomeUI();
      });

      document.getElementById("btnCancelEditTeacher").addEventListener("click", clearTeacherForm);

      document.getElementById("btnResetDefaultData").addEventListener("click", function () {
        if (confirm("수정하거나 추가한 문제를 지우고 2022 교육과정 기본 문제로 되돌릴까요?")) {
          curriculum = JSON.parse(JSON.stringify(DEFAULT_CURRICULUM));
          saveCurriculum();
          clearTeacherForm();
          renderTeacherList();
          refreshHomeUI();
        }
      });

      // 복사/붙여넣기 제한 (브라우저 내에서 시도하는 일반적인 방식 차단; 완전한 보안 잠금은 아님)
      document.addEventListener("keydown", function (e) {
        const key = String(e.key || "").toLowerCase();
        if ((e.ctrlKey || e.metaKey) && ["c", "v", "x", "a"].includes(key)) {
          e.preventDefault();
          e.stopPropagation();
        }
        if (e.shiftKey && (key === "insert" || key === "delete")) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);
      ["copy", "cut", "paste", "beforecopy", "beforecut", "beforepaste"].forEach(function (eventName) {
        document.addEventListener(eventName, function (e) {
          e.preventDefault();
          e.stopPropagation();
        }, true);
      });
      document.addEventListener("contextmenu", function (e) {
        e.preventDefault();
        e.stopPropagation();
      }, true);
      document.addEventListener("dragstart", function (e) {
        e.preventDefault();
        e.stopPropagation();
      }, true);

      // 초기 실행
      refreshHomeUI();
    })();
  </script>
</body>
</html>
