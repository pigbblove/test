      function handleCheckAnswer() {
        if (isProcessingClick || isCurrentLockedForRepeat) return;
        isProcessingClick = true;
        setTimeout(function () { isProcessingClick = false; }, 250);

        const item = studyQueue[currentIdx];
        const userEn = document.getElementById("answerEnglish").value;
        const userKo = document.getElementById("answerMeaning").value;
        const feedbackBox = document.getElementById("feedbackBox");
        const hintCard = document.getElementById("hintCard");

        if (!userEn.trim() || !userKo.trim()) {
          feedbackBox.className = "msg-box msg-warn";
          feedbackBox.textContent = "영어와 우리말 뜻을 모두 쓴 뒤 정답 확인하기를 눌러 주세요!";
          feedbackBox.classList.remove("hidden");
          return;
        }

        const enOk = checkEnglishMatch(userEn, item.english);
        const koOk = checkMeaningMatch(userKo, item.meanings);

        if (enOk && koOk) {
          playCorrectSound();
          if (attemptCountOnCurrent === 0) {
            firstTryCorrectCount++;
          }
          feedbackBox.className = "msg-box msg-success";
          feedbackBox.textContent =
            "🎉 정답이에요! 참 잘했어요! (" + item.english + " : " + item.meanings[0] + ")";
          feedbackBox.classList.remove("hidden");

          document.getElementById("answerEnglish").disabled = true;
          document.getElementById("answerMeaning").disabled = true;
          document.getElementById("btnCheckAnswer").disabled = true;
          document.getElementById("btnNextQuestion").classList.remove("hidden");
          return;
        }

        playWrongSound();
        attemptCountOnCurrent++;

        if (attemptCountOnCurrent === 1) {
          const svgBox = document.getElementById("hintSvgBox");
          svgBox.innerHTML = "";
          svgBox.appendChild(createMeaningHintSVG(item));

          let statusTip = "";
          if (!enOk && !koOk) statusTip = "영어 철자와 뜻을 다시 한 번 살펴보세요.";
          else if (!enOk) statusTip = "우리말 뜻은 맞았어요! 영어 철자를 다시 확인해 보세요.";
          else statusTip = "영어 철자는 맞았어요! 우리말 뜻을 다시 떠올려 보세요.";

          document.getElementById("hintText").textContent =
            statusTip + " " + (item.hint || "뜻 그림을 보고 알맞은 단어와 뜻을 다시 써 보세요!");
          hintCard.classList.remove("hidden");

          feedbackBox.className = "msg-box msg-error";
          feedbackBox.textContent = "앗, 한 번 더 도전해 볼까요? 뜻 그림 힌트를 보고 다시 써 보세요!";
          feedbackBox.classList.remove("hidden");
        } else {
          isCurrentLockedForRepeat = true;
          if (!wrongItemsInSession.some(function (w) { return w.id === item.id; })) {
            wrongItemsInSession.push(item);
          }
          addToPortfolio(item, "wrong");

          feedbackBox.className = "msg-box msg-error";
          feedbackBox.textContent =
            "정답은 [ " + item.english + " / 뜻: " + item.meanings.join(", ") + " ] 입니다. 5선지 글씨 모양을 보고 5번 써 봅시다!";
          feedbackBox.classList.remove("hidden");

          document.getElementById("answerEnglish").disabled = true;
          document.getElementById("answerMeaning").disabled = true;
          document.getElementById("btnCheckAnswer").disabled = true;

          const practiceArea = document.getElementById("fiveLinePracticeArea");
          practiceArea.classList.remove("hidden");
          renderFiveLineLetterDrawing(
            document.getElementById("fiveLineSvgContainer"),
            userEn,
            item.english
          );

          const nextBtn = document.getElementById("btnNextQuestion");
          nextBtn.classList.remove("hidden");
          nextBtn.disabled = true;

          buildFiveRepeatInputs(
            document.getElementById("repeatInputsContainer"),
            item.english,
            function (allDone) {
              nextBtn.disabled = !allDone;
            }
          );
        }
      }

      function recordExamResultToTeacher(retryCleared) {
        const total = studyQueue.length || 1;
