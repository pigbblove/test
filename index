      function speakEnglish(text, rate) {
        const fallbackBox = document.getElementById("ttsFallbackBox");
        if (!("speechSynthesis" in window) || typeof SpeechSynthesisUtterance === "undefined") {
          if (fallbackBox) {
            fallbackBox.textContent = "이 브라우저에서는 음성 재생이 지원되지 않아요. 뜻 그림 힌트를 보고 도전해 보세요!";
            fallbackBox.classList.remove("hidden");
          }
          return;
        }
        try {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(text);
          utter.lang = "en-US";
          utter.rate = rate || 0.9;
          utter.pitch = 1.02;

          const voices = (cachedVoices.length ? cachedVoices : window.speechSynthesis.getVoices()).slice().sort(function (a, b) { return (b.lang === "en-US") - (a.lang === "en-US"); });
          const enVoice = voices.find(function (v) {
            return v.lang && v.lang.toLowerCase().startsWith("en");
          });
          if (enVoice) utter.voice = enVoice;

          utter.onerror = function () {
            if (fallbackBox) {
