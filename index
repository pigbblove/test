          return normalizeEnglish(p.english) === normalizeEnglish(item.english);
        });
        const entry = {
          english: item.english,
          meaning: Array.isArray(item.meanings) ? item.meanings[0] : String(item.meaning || ""),
          unit: item.unit || "기본 단원",
          category: category,
          count: existsIdx >= 0 ? (portfolio[existsIdx].count || 1) + 1 : 1,
          updatedAt: new Date().toLocaleDateString("ko-KR")
        };
        if (existsIdx >= 0) {
          portfolio[existsIdx] = entry;
        } else {
          portfolio.unshift(entry);
        }
        savePortfolio();
      }

