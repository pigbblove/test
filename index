      /* =========================================================
         2. 효과음 & 유쾌한 배경음악(Web Audio API 내장 신시사이저)
      ========================================================= */
      let audioCtx = null;
      let soundEnabled = true;
      let bgmTimerId = null;
      let bgmStep = 0;

      const CHEERFUL_MELODY = [
        523.25, 659.25, 783.99, 659.25,
