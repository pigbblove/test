      /* =========================================================
         16. '영어잡기' 4단계 타자 게임 & 친구 공유
      ========================================================= */
      function prepareGamePools() {
        const sourceItems = learnedWordsInSession.length > 0 ? learnedWordsInSession : curriculum;
        const words = [];
        const sentences = [];
        const seenEn = new Set();

        sourceItems.forEach(function (item) {
          const key = normalizeEnglish(item.english);
          if (!key || seenEn.has(key)) return;
          seenEn.add(key);

          const entry = {
            english: item.english,
            meaning: Array.isArray(item.meanings) ? item.meanings[0] : (item.meaning || ""),
            isSentence: item.type === "sentence" || item.english.trim().includes(" ")
          };

          if (entry.isSentence) {
            sentences.push(entry);
          } else {
            words.push(entry);
          }
        });

        // 단어 풀이 비어 있으면 전체 커리큘럼 단어로 보완
        if (words.length === 0) {
          curriculum.forEach(function (c) {
            if (!c.english.trim().includes(" ")) {
              words.push({ english: c.english, meaning: c.meanings[0] || "", isSentence: false });
            }
          });
        }

        // 문장 풀이 비어 있으면 전체 커리큘럼 문장으로 보완
        if (sentences.length === 0) {
          curriculum.forEach(function (c) {
            if (c.type === "sentence" || c.english.trim().includes(" ")) {
              sentences.push({ english: c.english, meaning: c.meanings[0] || "", isSentence: true });
            }
          });
        }

        gameWordPool = words.length > 0 ? words : [{ english: "grade", meaning: "학년", isSentence: false }];
        gameSentencePool = sentences.length > 0 ? sentences : gameWordPool.slice();
      }

      function openGameScreen() {
        showScreen("screenGame");
        updateShareCodeExport();
      }

      function updateShareCodeExport() {
        const bestScore = Number(safeGetItem(STORAGE_KEYS.BEST_SCORE) || 0);
        const g = studentInfo.grade || "5";
        const c = studentInfo.classNum || "0";
        const n = studentInfo.studentNum || "0";
        const payload = { g: g, c: c, n: n, s: bestScore };
        try {
          const encoded = btoa(encodeURIComponent(JSON.stringify(payload)));
          document.getElementById("shareCodeExport").value = "EG-" + encoded;
        } catch (e) {
          document.getElementById("shareCodeExport").value = "EG-" + g + "-" + c + "-" + n + "-" + bestScore;
        }
      }

      function stopTypingGameLoop() {
        gameRunning = false;
        if (gameLoopId !== null) {
          cancelAnimationFrame(gameLoopId);
          gameLoopId = null;
        }
      }

      function startTypingGame() {
        ensureAudioContext();
        prepareGamePools();

        const stage = document.getElementById("skyDropStage");
        stage.querySelectorAll(".falling-word-bubble").forEach(function (el) {
          el.remove();
        });

        activeFallingWords = [];
        currentStage = 1;
        stageClearedWords = 0;
        totalCaughtWords = 0;
        missedWordCounts = [0, 0];
        gameScores = [0, 0];
        gameTurn = 0;
        spawnAccumulatorMs = 0;
        gameRunning = true;
        lastFrameTime = performance.now();

        document.getElementById("gamePlayArea").classList.remove("hidden");
        document.getElementById("gameEndArea").classList.add("hidden");
        document.getElementById("gameRoundFeedback").classList.add("hidden");

        const inputEl = document.getElementById("gameTypeInput");
        inputEl.value = "";
        inputEl.disabled = false;
        inputEl.focus();

        updateGameHud();
        spawnFallingWord();
        startCheerfulBgm();

        gameLoopId = requestAnimationFrame(stepTypingGameLoop);
      }

      // 1단계는 아주 천천히 시작(초당 14px), 단계가 오를수록 조금씩 빨라짐
      function getStageFallSpeedPxPerSec() {
        if (currentStage === 1) return 14;
        if (currentStage === 2) return 22;
        if (currentStage === 3) return 31;
        return 26; // 4단계는 문장 길이가 길므로 여유 있는 속도로 출제
      }

      function getStageSpawnIntervalMs() {
        if (currentStage === 1) return 3600;
        if (currentStage === 2) return 2900;
        if (currentStage === 3) return 2300;
        return 3400;
      }

      function spawnFallingWord() {
        const stage = document.getElementById("skyDropStage");
        if (!stage) return;

        let candidatePool = gameWordPool;
        if (currentStage === 4) {
          // 4단계에서는 문장 위주로 등장(문장 75%, 단어 25%)
          candidatePool = Math.random() < 0.75 ? gameSentencePool : gameWordPool;
        }

        const pick = candidatePool[Math.floor(Math.random() * candidatePool.length)];
        const bubble = document.createElement("div");
        bubble.className = "falling-word-bubble" + (pick.isSentence ? " sentence-bubble" : "");

        const enDiv = document.createElement("div");
        enDiv.className = "falling-word-en";
        enDiv.textContent = pick.english;

        const koDiv = document.createElement("div");
        koDiv.className = "falling-word-ko";
        koDiv.textContent = (pick.isSentence ? "[문장] " : "") + pick.meaning;

        bubble.appendChild(enDiv);
        bubble.appendChild(koDiv);
        stage.appendChild(bubble);

        const stageWidth = stage.clientWidth || 600;
        const leftPercent = pick.isSentence ? 50 : (20 + Math.random() * 60);
        const xPx = (stageWidth * leftPercent) / 100;

        const itemObj = {
          id: "fw-" + Date.now() + "-" + Math.random(),
          english: pick.english,
          meaning: pick.meaning,
          isSentence: pick.isSentence,
          xPx: xPx,
          yPx: 10,
          el: bubble
        };

        bubble.style.left = itemObj.xPx + "px";
        bubble.style.top = itemObj.yPx + "px";
        activeFallingWords.push(itemObj);
      }

      function updateGameHud() {
        const stageNames = {
          1: "1단계 (아주 천천히)",
          2: "2단계 (조금 빠르게)",
          3: "3단계 (더 빠르게)",
          4: "4단계 (문장 등장!)"
        };

        document.getElementById("hudStageText").textContent = stageNames[currentStage] || "1단계";
        document.getElementById("hudStageProgressText").textContent =
          currentStage <= 3 ? (stageClearedWords + " / 10") : ("문장 " + stageClearedWords + "개 잡음");
        document.getElementById("hudTotalScoreText").textContent = (gameMode === "dual" ? gameScores[gameTurn] : gameScores[0]) + "점";
        document.getElementById("hudCatchMissText").textContent =
          totalCaughtWords + "개 / " + missedWordCounts[gameTurn] + "번";

        for (let s = 1; s <= 4; s++) {
          const chip = document.getElementById("chipStage" + s);
          if (!chip) continue;
          chip.className = "stage-chip";
          if (s < currentStage) chip.classList.add("cleared");
          else if (s === currentStage) chip.classList.add("current");
        }

        const scoreboard = document.getElementById("gameScoreboard");
        scoreboard.innerHTML = "";

        const p1 = document.createElement("div");
        p1.className = "score-pill" + (gameTurn === 0 ? " active-turn" : "");
        p1.textContent = (gameMode === "dual" ? "1P 점수: " : "내 점수: ") + gameScores[0] + "점";
        scoreboard.appendChild(p1);

        if (gameMode === "dual") {
          const p2 = document.createElement("div");
          p2.className = "score-pill" + (gameTurn === 1 ? " active-turn" : "");
          p2.textContent = "2P 점수: " + gameScores[1] + "점 (놓침 " + missedWordCounts[1] + "/3)";
          scoreboard.appendChild(p2);
        } else if (rivalTarget) {
          const rivalPill = document.createElement("div");
          rivalPill.className = "score-pill";
          rivalPill.textContent =
            rivalTarget.g + "학년 " + rivalTarget.c + "반 " + rivalTarget.n + "번 친구: " + rivalTarget.s + "점";
          scoreboard.appendChild(rivalPill);
        }

        const turnBanner = document.getElementById("gameTurnBanner");
        turnBanner.textContent =
          stageNames[currentStage] + " — " +
          (currentStage <= 3
            ? "10단어를 잡으면 다음 단계로 올라가요! (현재 " + stageClearedWords + "/10)"
            : "문장이 내려와요! 끝까지 문장을 완성해 보세요!") +
          (gameMode === "dual" ? (gameTurn === 0 ? " · [1P 차례]" : " · [2P 차례]") : "");
      }

      function stepTypingGameLoop(now) {
        if (!gameRunning) return;
        const dtMs = Math.min(100, now - lastFrameTime);
        lastFrameTime = now;
        const dtSec = dtMs / 1000;

        spawnAccumulatorMs += dtMs;
        const spawnInterval = getStageSpawnIntervalMs();
        const maxSimultaneous = currentStage === 1 ? 2 : 3;

        if (spawnAccumulatorMs >= spawnInterval && activeFallingWords.length < maxSimultaneous) {
          spawnAccumulatorMs = 0;
          spawnFallingWord();
        }

        const stage = document.getElementById("skyDropStage");
        const stageHeight = stage ? stage.clientHeight : 330;
        const floorLimitY = stageHeight - 66;
        const speedPx = getStageFallSpeedPxPerSec();

        const remaining = [];
        let floorHitHappened = false;

        activeFallingWords.forEach(function (fw) {
          fw.yPx += speedPx * dtSec;
          if (fw.yPx >= floorLimitY) {
            floorHitHappened = true;
            missedWordCounts[gameTurn]++;
            if (fw.el && fw.el.parentNode) {
              fw.el.parentNode.removeChild(fw.el);
            }
          } else {
            if (fw.el) {
              fw.el.style.top = fw.yPx + "px";
            }
            remaining.push(fw);
          }
        });

        activeFallingWords = remaining;

        if (floorHitHappened) {
          playHitFloorSound();
          const fb = document.getElementById("gameRoundFeedback");
          fb.className = "msg-box msg-error";
          fb.textContent = "💥 바닥에 닿았어요! (" + missedWordCounts[gameTurn] + " / 3번 놓침)";
          fb.classList.remove("hidden");

          if (gameMode === "dual") {
            gameTurn = gameTurn === 0 ? 1 : 0;
          }

          if (missedWordCounts[0] >= 3 || (gameMode === "dual" && missedWordCounts[1] >= 3)) {
            finishTypingGame();
            return;
          }
        }

        updateGameHud();
        gameLoopId = requestAnimationFrame(stepTypingGameLoop);
      }

      function handleTypedGameWord() {
        if (!gameRunning) return;
        const inputEl = document.getElementById("gameTypeInput");
        const typed = inputEl.value;
        const fb = document.getElementById("gameRoundFeedback");

        if (!typed.trim()) {
          fb.className = "msg-box msg-warn";
          fb.textContent = "내려오는 영어 단어나 문장을 입력해 보세요!";
          fb.classList.remove("hidden");
          return;
        }

        const matchIdx = activeFallingWords.findIndex(function (fw) {
          return normalizeEnglish(typed) === normalizeEnglish(fw.english);
        });

        if (matchIdx >= 0) {
          const hitItem = activeFallingWords[matchIdx];
          activeFallingWords.splice(matchIdx, 1);
          if (hitItem.el && hitItem.el.parentNode) {
            hitItem.el.parentNode.removeChild(hitItem.el);
          }

          totalCaughtWords++;
          stageClearedWords++;
          const pointsEarned = hitItem.isSentence ? 200 : 100;
          gameScores[gameTurn] += pointsEarned;
          inputEl.value = "";

          let stageUpNotice = "";
          if (currentStage < 4 && stageClearedWords >= 10) {
            currentStage++;
            stageClearedWords = 0;
            playStageUpSound();
            stageUpNotice =
              currentStage === 4
                ? " 🎊 축하해요! 4단계 '문장 등장' 단계로 올라갔어요!"
                : " 🎊 축하해요! " + currentStage + "단계로 올라갔어요!";
          } else {
            playCorrectSound();
          }

          fb.className = "msg-box msg-success";
          fb.textContent = "⚡ [ " + hitItem.english + " ] 잡기 성공! +" + pointsEarned + "점!" + stageUpNotice;
          fb.classList.remove("hidden");
          updateGameHud();
        } else {
          playWrongSound();
          fb.className = "msg-box msg-error";
          fb.textContent = "내려오는 단어·문장과 철자가 조금 달라요! 다시 입력해 보세요!";
          fb.classList.remove("hidden");
        }
      }

      function finishTypingGame() {
        stopTypingGameLoop();
        stopCheerfulBgm();

        document.getElementById("gamePlayArea").classList.add("hidden");
        const endArea = document.getElementById("gameEndArea");
        const resultBox = document.getElementById("gameFinalResult");
        endArea.classList.remove("hidden");

        const prevBest = Number(safeGetItem(STORAGE_KEYS.BEST_SCORE) || 0);
        if (gameScores[0] > prevBest) {
          safeSetItem(STORAGE_KEYS.BEST_SCORE, String(gameScores[0]));
        }
        updateShareCodeExport();

        if (gameMode === "dual") {
          let winnerMsg = "무승부! 둘 다 정말 멋지게 잡았어요!";
          if (gameScores[0] > gameScores[1]) winnerMsg = "🏆 1P 승리! 축하해요!";
          else if (gameScores[1] > gameScores[0]) winnerMsg = "🏆 2P 승리! 축하해요!";
          resultBox.textContent =
            "영어잡기 종료! (" + currentStage + "단계 도달) [ 1P: " + gameScores[0] + "점 vs 2P: " +
            gameScores[1] + "점 ] — " + winnerMsg;
        } else if (rivalTarget) {
          const diff = gameScores[0] - rivalTarget.s;
          const vsMsg = diff > 0
            ? "친구 기록보다 " + diff + "점 높아서 이겼어요!"
            : diff === 0
              ? "친구와 똑같은 동점이에요!"
              : "친구 기록까지 " + Math.abs(diff) + "점 차이예요! 다시 도전해 보세요!";
          resultBox.textContent =
            "영어잡기 종료! 도달 단계: " + currentStage + "단계 · 내 점수: " + gameScores[0] +
            "점 (총 " + totalCaughtWords + "개 잡음)! " + vsMsg;
        } else {
          resultBox.textContent =
            "영어잡기 종료! 도달 단계: " + currentStage + "단계 · 내 점수: " + gameScores[0] +
            "점 (총 " + totalCaughtWords + "개 잡음, 최고 기록: " + Math.max(prevBest, gameScores[0]) + "점)! 아래 공유 코드로 친구와 겨뤄 보세요!";
        }
      }

