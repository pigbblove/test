        if (studentInfo.classNum && studentInfo.studentNum) {
          badge.textContent = studentInfo.grade + "학년 " + studentInfo.classNum + "반 " + studentInfo.studentNum + "번";
        } else {
          badge.textContent = "학년·반·번호 미입력";
        }

        document.getElementById("selectGrade").value = studentInfo.grade || "5";
        document.getElementById("inputClass").value = studentInfo.classNum;
        document.getElementById("inputNumber").value = studentInfo.studentNum;

        populateUnitSelectByGrade(document.getElementById("selectGrade").value);

        const storageText = document.getElementById("storageStatusText");
        if (isLocalStorageAvailable) {
          storageText.textContent = "안내: 이 브라우저에 내 단어장·시험 결과·문제가 자동 저장됩니다. (이름·사진 등 개인정보는 수집하지 않아요)";
        } else {
          storageText.textContent = "안내: 브라우저 임시 저장 모드로 작동 중입니다. 새로고침 전까지 정상 동작합니다.";
        }
      }

      function populateUnitSelectByGrade(gradeVal) {
        const selectUnit = document.getElementById("selectUnit");
        selectUnit.innerHTML = "";

        const gradeItems = curriculum.filter(function (item) {
          return String(item.grade || "5") === String(gradeVal);
        });

        const optAll = document.createElement("option");
        optAll.value = "ALL_GRADE";
        optAll.textContent = gradeVal + "학년 전체 단원 (" + gradeItems.length + "문제)";
        selectUnit.appendChild(optAll);

        // 2022 개정 교육과정 5~6학년군: 교과서별 단원 주제가 다르므로
        // 기존 등록 주제는 유지하고, 비어 있는 단원도 1~6까지 선택할 수 있게 표시합니다.
        const unitByNumber = {};
        gradeItems.forEach(function (item) {
          const match = String(item.unit || "").match(/(\d+)단원/);
          if (match) unitByNumber[Number(match[1])] = item.unit;
        });

        for (let unitNo = 1; unitNo <= 6; unitNo++) {
          const unitLabel = unitByNumber[unitNo] || (gradeVal + "학년 " + unitNo + "단원 (문제 등록 필요)");
          const count = gradeItems.filter(function (item) { return item.unit === unitLabel; }).length;
          const opt = document.createElement("option");
          opt.value = unitLabel;
          opt.textContent = unitLabel + " · " + count + "문제";
          selectUnit.appendChild(opt);
        }
      }

      /* =========================================================
         12. 받아쓰기 학습 & 채점
      ========================================================= */
      function startStudySession() {
        ensureAudioContext();
        const gradeVal = document.getElementById("selectGrade").value;
        const classVal = document.getElementById("inputClass").value.trim();
        const numVal = document.getElementById("inputNumber").value.trim();
        const homeAlert = document.getElementById("homeAlert");

        if (!classVal || !numVal || Number(classVal) < 1 || Number(numVal) < 1) {
          homeAlert.textContent = "반과 번호를 1 이상의 숫자로 입력해 주세요! (예: 6반 12번)";
          homeAlert.classList.remove("hidden");
          return;
        }
        homeAlert.classList.add("hidden");

        studentInfo = {
          grade: gradeVal,
          classNum: String(Number(classVal)),
          studentNum: String(Number(numVal))
        };
        saveStudentInfo();
        refreshHomeUI();

        const selectedUnit = document.getElementById("selectUnit").value;
        const selectedMode = document.getElementById("selectMode").value;

        const filtered = curriculum.filter(function (item) {
          const sameGrade = String(item.grade || "5") === String(gradeVal);
          const unitOk = selectedUnit === "ALL_GRADE" || item.unit === selectedUnit;
          const modeOk = selectedMode === "all" || item.type === selectedMode;
          return sameGrade && unitOk && modeOk;
        });

        if (filtered.length === 0) {
          homeAlert.textContent = "선택한 조건에 맞는 문제가 없어요. 다른 단원이나 유형을 골라 주세요!";
          homeAlert.classList.remove("hidden");
          return;
        }

        studyQueue = filtered;
        currentIdx = 0;
        firstTryCorrectCount = 0;
        wrongItemsInSession = [];
        learnedWordsInSession = filtered.slice();
        retryClearedCount = 0;
        currentSessionUnitLabel = selectedUnit === "ALL_GRADE" ? (gradeVal + "학년 전체 단원") : selectedUnit;

        showScreen("screenStudy");
        loadStudyQuestion();
      }

