      /* =========================================================
         9. 영어공책 5선지 위에 '정확한 글씨 그림(SVG)' 그리기
      ========================================================= */
      const ASCENDERS = new Set(["b", "d", "f", "h", "k", "l", "t"]);

      function renderFiveLineLetterDrawing(containerEl, userStr, targetStr) {
        containerEl.innerHTML = "";
        const target = String(targetStr || "");
        const userTrim = String(userStr || "").trim();
        const matchedArr = (function () {
          var a = target, b = userTrim, n = a.length, m = b.length, d = [], i, j;
          for (i = 0; i <= n; i++) d.push(new Array(m + 1).fill(0));
          function eq(x, y) { return x === x.toLowerCase() ? x === y.toLowerCase() : x === y; }
          for (i = n - 1; i >= 0; i--) {
            for (j = m - 1; j >= 0; j--) {
              d[i][j] = eq(a[i], b[j]) ? d[i + 1][j + 1] + 1 : Math.max(d[i + 1][j], d[i][j + 1]);
            }
          }
          var r = new Array(n).fill(false);
          i = 0; j = 0;
          while (i < n && j < m) {
            if (eq(a[i], b[j])) { r[i] = true; i++; j++; }
            else if (d[i + 1][j] >= d[i][j + 1]) i++;
            else j++;
          }
          return r;
        })();

        const charWidth = 28;
        const leftPad = 18;
        const svgWidth = Math.max(420, leftPad * 2 + target.length * charWidth + 20);
        const svgHeight = 114;

        const yTopBlue = 22;
        const yMidDash = 41;
        const yRedBase = 60;
        const yLowBlue = 79;
        const yDescGuide = 98;

        const svgNS = "http://www.w3.org/2000/svg";
        const svg = document.createElementNS(svgNS, "svg");
        svg.setAttribute("viewBox", "0 0 " + svgWidth + " " + svgHeight);
        svg.setAttribute("width", String(svgWidth));
        svg.setAttribute("height", String(svgHeight));
        svg.style.display = "block";

        function addLine(y, stroke, width, dash) {
          const line = document.createElementNS(svgNS, "line");
          line.setAttribute("x1", "8");
          line.setAttribute("x2", String(svgWidth - 8));
          line.setAttribute("y1", String(y));
          line.setAttribute("y2", String(y));
          line.setAttribute("stroke", stroke);
          line.setAttribute("stroke-width", String(width));
          if (dash) line.setAttribute("stroke-dasharray", dash);
          svg.appendChild(line);
        }

        addLine(yTopBlue, "#74c0fc", 2, null);
        addLine(yMidDash, "#ced4da", 1.5, "5,4");
        addLine(yRedBase, "#ff6b6b", 2.5, null);
        addLine(yLowBlue, "#74c0fc", 2, null);
        addLine(yDescGuide, "#e9ecef", 1.5, "3,4");

        for (let i = 0; i < target.length; i++) {
          const ch = target[i];
          const xPos = leftPad + i * charWidth;

          if (ch === " ") {
            const spaceMark = document.createElementNS(svgNS, "circle");
            spaceMark.setAttribute("cx", String(xPos + 10));
            spaceMark.setAttribute("cy", String(yRedBase - 6));
            spaceMark.setAttribute("r", "2.5");
            spaceMark.setAttribute("fill", "#adb5bd");
            svg.appendChild(spaceMark);
            continue;
          }

          const userCh = userTrim[i] || "";
          const isMatched = !!matchedArr[i];

          const isUpper = ch >= "A" && ch <= "Z";
          const lowerCh = ch.toLowerCase();
          const fontSize = (isUpper || ASCENDERS.has(lowerCh)) ? 42 : 37;
          const fillColor = isMatched ? "#2b8a3e" : "#e03131";

          if (!isMatched) {
            const highlightBg = document.createElementNS(svgNS, "rect");
            highlightBg.setAttribute("x", String(xPos - 2));
            highlightBg.setAttribute("y", String(yTopBlue));
            highlightBg.setAttribute("width", String(charWidth - 4));
            highlightBg.setAttribute("height", String(yDescGuide - yTopBlue));
            highlightBg.setAttribute("rx", "6");
            highlightBg.setAttribute("fill", "#fff5f5");
            svg.appendChild(highlightBg);
          }

          const letterEl = document.createElementNS(svgNS, "text");
          letterEl.setAttribute("x", String(xPos + 2));
          letterEl.setAttribute("y", String(yRedBase));
          letterEl.setAttribute("fill", fillColor);
          letterEl.setAttribute("font-size", String(fontSize));
          letterEl.setAttribute("font-weight", "800");
          letterEl.setAttribute("font-family", '"Comic Sans MS", "Trebuchet MS", "Arial Rounded MT Bold", sans-serif');
          letterEl.textContent = ch;
          svg.appendChild(letterEl);
        }

        containerEl.appendChild(svg);
      }

